/* Reset & Pitch-Black Dark Theme */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #09090b;
  color: #fafafa;
  line-height: 1.6;
}

/* Navigation Bar */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 8%;
  background-color: #121215;
  border-bottom: 1px solid #27272a;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
  letter-spacing: 1px;
}

.logo span {
  color: #22d3ee;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 24px;
}

.nav-links a {
  color: #a1a1aa;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: #22d3ee;
}

/* Timer & History Workspace */
.timer-workspace {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
  max-width: 1200px;
  margin: 40px auto 20px;
  padding: 0 8%;
}

@media (max-width: 850px) {
  .timer-workspace {
    grid-template-columns: 1fr;
  }
}

.timer-container {
  text-align: center;
  padding: 50px 20px;
  background-color: #121215;
  border: 1px solid #27272a;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.scramble-box {
  font-family: 'Courier New', Courier, monospace;
  font-size: 1.15rem;
  color: #e4e4e7;
  background-color: #18181b;
  padding: 10px 18px;
  border-radius: 8px;
  margin-bottom: 20px;
  letter-spacing: 2px;
  border: 1px solid #27272a;
}

.timer-display {
  font-family: 'Courier New', Courier, monospace;
  font-size: 5.5rem;
  font-weight: bold;
  color: #fafafa;
  margin: 10px 0;
  user-select: none;
}

.timer-holding {
  color: #ef4444;
}

.timer-ready {
  color: #22c55e;
}

.timer-hint {
  color: #a1a1aa;
  font-size: 0.95rem;
  margin-bottom: 24px;
}

.timer-controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

.btn-primary {
  background-color: #22d3ee;
  color: #09090b;
  border: none;
  padding: 8px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  font-size: 0.9rem;
  transition: background-color 0.2s ease;
}

.btn-primary:hover {
  background-color: #67e8f9;
}

.btn-secondary {
  background-color: #18181b;
  color: #e4e4e7;
  border: 1px solid #3f3f46;
  padding: 8px 14px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.btn-secondary:hover {
  background-color: #27272a;
  border-color: #22d3ee;
}

/* Solve History Sidebar */
.history-panel {
  background-color: #121215;
  border: 1px solid #27272a;
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  max-height: 380px;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.btn-small {
  background: #18181b;
  color: #a1a1aa;
  border: 1px solid #3f3f46;
  padding: 4px 10px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.8rem;
}

.btn-small:hover {
  color: #ef4444;
  border-color: #ef4444;
}

.stats-bar {
  display: flex;
  justify-content: space-between;
  background-color: #18181b;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 12px;
  font-size: 0.9rem;
  color: #a1a1aa;
}

.stats-bar span {
  color: #22d3ee;
  font-weight: bold;
  font-family: 'Courier New', Courier, monospace;
}

.solve-list {
  list-style: none;
  overflow-y: auto;
  flex-grow: 1;
}

.solve-list li {
  display: flex;
  justify-content: space-between;
  padding: 8px 10px;
  border-bottom: 1px solid #27272a;
  font-family: 'Courier New', Courier, monospace;
  font-size: 0.95rem;
}

.solve-list li.empty-msg {
  color: #71717a;
  font-family: 'Segoe UI', sans-serif;
  border: none;
  justify-content: center;
  padding-top: 30px;
}

/* Shared Section Layout */
.section-container {
  padding: 40px 8%;
  max-width: 1200px;
  margin: 0 auto;
}

.section-container h2 {
  font-size: 1.8rem;
  margin-bottom: 12px;
}

.section-sub {
  color: #a1a1aa;
  margin-bottom: 20px;
  font-size: 0.95rem;
}

/* Course Cards */
.course-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.card {
  background-color: #121215;
  border: 1px solid #27272a;
  border-radius: 12px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: #22d3ee;
}

.card-badge {
  display: inline-block;
  background-color: #18181b;
  color: #22d3ee;
  font-size: 0.8rem;
  font-weight: bold;
  padding: 4px 10px;
  border-radius: 20px;
  margin-bottom: 12px;
  width: fit-content;
  border: 1px solid #27272a;
}

.card h3 {
  font-size: 1.25rem;
  margin-bottom: 10px;
}

.card p {
  color: #a1a1aa;
  font-size: 0.95rem;
  margin-bottom: 20px;
}

.card-link {
  color: #22d3ee;
  text-decoration: none;
  font-weight: bold;
}

.card-link:hover {
  text-decoration: underline;
}

/* Algorithm Filter Tabs */
.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.filter-btn {
  background-color: #121215;
  color: #a1a1aa;
  border: 1px solid #27272a;
  padding: 6px 16px;
  border-radius: 20px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.2s ease;
}

.filter-btn:hover,
.filter-btn.active {
  background-color: #22d3ee;
  color: #09090b;
  font-weight: bold;
  border-color: #22d3ee;
}

/* Algorithm Cards */
.algo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.algo-card {
  background-color: #121215;
  border: 1px solid #27272a;
  border-radius: 12px;
  padding: 20px;
}

.algo-tag {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #22c55e;
  font-weight: bold;
}

.algo-card h4 {
  font-size: 1.15rem;
  margin: 6px 0 12px;
}

.algo-moves {
  display: block;
  background-color: #18181b;
  color: #22d3ee;
  font-family: 'Courier New', Courier, monospace;
  font-size: 1.05rem;
  font-weight: bold;
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #27272a;
  margin-bottom: 12px;
}

.algo-card p {
  color: #a1a1aa;
  font-size: 0.9rem;
}

/* Footer */
footer {
  text-align: center;
  padding: 24px;
  margin-top: 40px;
  background-color: #121215;
  color: #71717a;
  font-size: 0.9rem;
  border-top: 1px solid #27272a;
}
