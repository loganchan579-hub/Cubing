<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Styled Website</title>
    <style>
        /* This is the CSS styling area */
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            line-height: 1.6;
            max-width: 600px;
            margin: 40px auto;
            padding: 0 20px;
            color: #333;
            background-color: #f9f9f9;
        }

        h1 {
            color: #2f81f7; /* GitHub blue color */
            border-bottom: 2px solid #eaecef;
            padding-bottom: 10px;
        }

        p {
            font-size: 1.1rem;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            border: 1px solid #e1e4e8;
        }
    </style>
</head>
<body>
    <h1>Hello World!</h1>
    <div class="card">
        <p>Welcome to my beautifully styled GitHub Pages website.</p>
        <p>This box is styled using a modern CSS card layout!</p>
    </div>
</body>
</html>

