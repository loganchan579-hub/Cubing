<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hello Cubers | Master the Solve</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Top Navigation Bar -->
  <header class="navbar">
    <div class="logo">Hello<span>Cubers</span></div>
    <nav>
      <ul class="nav-links">
        <li><a href="#timer-section">Timer</a></li>
        <li><a href="#courses">Courses</a></li>
        <li><a href="#algorithms">Algorithms</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Timer & Solve History Split Layout -->
    <section id="timer-section" class="timer-workspace">
      
      <!-- Left: Spacebar & Click Timer -->
      <div class="timer-container" id="timer-touch-area">
        <div class="scramble-box" id="scramble">R U R' U' F2 D' L2 U B2 R2 U'</div>
        
        <div id="timer-display" class="timer-display">0.00</div>
        
        <p id="timer-status" class="timer-hint">Hold <strong>SPACEBAR</strong> until green, then release (or click Start)</p>
        
        <div class="timer-controls">
          <button type="button" id="toggle-btn" class="btn-primary">Start / Stop</button>
          <button type="button" id="plus2-btn" class="btn-secondary">+2</button>
          <button type="button" id="dnf-btn" class="btn-secondary">DNF</button>
          <button type="button" id="new-scramble-btn" class="btn-secondary">New Scramble</button>
        </div>
      </div>

      <!-- Right: Solve History & Ao5 -->
      <aside class="history-panel">
        <div class="history-header">
          <h3>Solve Times</h3>
          <button type="button" id="clear-history-btn" class="btn-small">Clear</button>
        </div>
        <div class="stats-bar">
          <div>Best: <span id="best-time">-</span></div>
          <div>Ao5: <span id="ao5-time">-</span></div>
        </div>
        <ul id="solve-list" class="solve-list">
          <li class="empty-msg">No solves yet. Hold Spacebar!</li>
        </ul>
      </aside>

    </section>

    <!-- Course Cards Grid -->
    <section id="courses" class="section-container">
      <h2>Learning Modules</h2>
      <div class="course-grid">
        
        <article class="card">
          <div class="card-badge">Stage 1</div>
          <h3>1. The Layer-by-Layer Method</h3>
          <p>Start with the White Cross, insert the first-layer corners, and finish the middle layer edges.</p>
          <a href="#algorithms" class="card-link">View Beginner Algorithms &darr;</a>
        </article>

        <article class="card">
          <div class="card-badge">Stage 2</div>
          <h3>2. Intuitive F2L</h3>
          <p>Pair corner and edge pieces together in one smooth motion to cut your solve times in half.</p>
          <a href="#algorithms" class="card-link">View F2L Cases &darr;</a>
        </article>

        <article class="card">
          <div class="card-badge">Stage 3</div>
          <h3>3. 2-Look OLL &amp; PLL</h3>
          <p>Orient the yellow top face and permute the last layer pieces using essential speedcubing formulas.</p>
          <a href="#algorithms" class="card-link">View Last Layer Algs &darr;</a>
        </article>

      </div>
    </section>

    <!-- Interactive Algorithm Library with Filter Tabs -->
    <section id="algorithms" class="section-container">
      <h2>Essential 3x3 Algorithm Sheet</h2>
      <p class="section-sub">Notation: <strong>R</strong> = Right, <strong>L</strong> = Left, <strong>U</strong> = Up, <strong>D</strong> = Down, <strong>F</strong> = Front. Apostrophe (<strong>'</strong>) = counter-clockwise.</p>
      
      <!-- Filter Buttons -->
      <div class="filter-tabs">
        <button type="button" class="filter-btn active" data-filter="all">All</button>
        <button type="button" class="filter-btn" data-filter="beginner">Beginner</button>
        <button type="button" class="filter-btn" data-filter="f2l">F2L</button>
        <button type="button" class="filter-btn" data-filter="oll">OLL</button>
        <button type="button" class="filter-btn" data-filter="pll">PLL</button>
      </div>

      <div class="algo-grid" id="algo-grid">
        
        <div class="algo-card" data-category="beginner">
          <span class="algo-tag">Beginner</span>
          <h4>Right-Hand Trigger</h4>
          <code class="algo-moves">R U R' U'</code>
          <p>Used for inserting white corners and orienting yellow corners at the end.</p>
        </div>

        <div class="algo-card" data-category="beginner">
          <span class="algo-tag">Beginner</span>
          <h4>Second Layer Edge (Right)</h4>
          <code class="algo-moves">U R U' R' U' F' U F</code>
          <p>Moves a top edge piece into the middle-right slot without breaking the white face.</p>
        </div>

        <div class="algo-card" data-category="f2l">
          <span class="algo-tag">F2L</span>
          <h4>Basic F2L Corner-Edge Insert</h4>
          <code class="algo-moves">U R U' R'</code>
          <p>Inserts a paired corner and edge directly into the front-right slot.</p>
        </div>

        <div class="algo-card" data-category="oll">
          <span class="algo-tag">OLL</span>
          <h4>Yellow Cross (Line Case)</h4>
          <code class="algo-moves">F R U R' U' F'</code>
          <p>Hold the horizontal yellow line flat and apply to form the top yellow cross.</p>
        </div>

        <div class="algo-card" data-category="oll">
          <span class="algo-tag">OLL</span>
          <h4>Sune (Corner Orientation)</h4>
          <code class="algo-moves">R U R' U R U2 R'</code>
          <p>Solves the yellow top face when one yellow corner is pointing up in the front-left.</p>
        </div>

        <div class="algo-card" data-category="pll">
          <span class="algo-tag">PLL</span>
          <h4>T-Perm (Swap Corners &amp; Edges)</h4>
          <code class="algo-moves">R U R' U' R' F R2 U' R' U' R U R' F'</code>
          <p>Fastest PLL algorithm for swapping two adjacent corners and two edges.</p>
        </div>

        <div class="algo-card" data-category="pll">
          <span class="algo-tag">PLL</span>
          <h4>Ua-Perm (3-Edge Cycle)</h4>
          <code class="algo-moves">R U' R U R U R U' R' U' R2</code>
          <p>Cycles three top-layer edges counter-clockwise when all corners are solved.</p>
        </div>

      </div>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 Hello Cubers. Built with HTML, CSS &amp; JS.</p>
  </footer>

  <!-- Built-in Timer & Filter Script (No external JS file required) -->
  <script>
    const display = document.getElementById('timer-display');
    const statusText = document.getElementById('timer-status');
    const scrambleBox = document.getElementById('scramble');
    const toggleBtn = document.getElementById('toggle-btn');
    const plus2Btn = document.getElementById('plus2-btn');
    const dnfBtn = document.getElementById('dnf-btn');
    const newScrambleBtn = document.getElementById('new-scramble-btn');
    const clearHistoryBtn = document.getElementById('clear-history-btn');
    const solveList = document.getElementById('solve-list');
    const bestTimeEl = document.getElementById('best-time');
    const ao5TimeEl = document.getElementById('ao5-time');

    let startTime = 0;
    let timerInterval = null;
    let holdTimeout = null;
    let isRunning = false;
    let isReady = false;
    let isHolding = false;
    let solves = []; // Stores objects: { time: number, penalty: '' | '+2' | 'DNF' }

    function generateScramble() {
      const moves = ['R', 'L', 'U', 'D', 'F', 'B'];
      const modifiers = ['', "'", '2'];
      let scramble = [];
      let lastMove = '';

      for (let i = 0; i < 15; i++) {
        let move;
        do {
          move = moves[Math.floor(Math.random() * moves.length)];
        } while (move === lastMove);
        lastMove = move;
        const mod = modifiers[Math.floor(Math.random() * modifiers.length)];
        scramble.push(move + mod);
      }
      scrambleBox.textContent = scramble.join(' ');
    }

    function formatSolve(solve) {
      if (solve.penalty === 'DNF') return 'DNF';
      if (solve.penalty === '+2') return (solve.time + 2).toFixed(2) + '+';
      return solve.time.toFixed(2) + 's';
    }

    function getNumericTime(solve) {
      if (solve.penalty === 'DNF') return Infinity;
      return solve.penalty === '+2' ? solve.time + 2 : solve.time;
    }

    function updateStats() {
      if (solves.length === 0) {
        solveList.innerHTML = '<li class="empty-msg">No solves yet. Hold Spacebar!</li>';
        bestTimeEl.textContent = '-';
        ao5TimeEl.textContent = '-';
        return;
      }

      solveList.innerHTML = '';
      solves.slice().reverse().forEach((solve, index) => {
        const solveNumber = solves.length - index;
        const li = document.createElement('li');
        li.innerHTML = `<span>#${solveNumber}</span><strong>${formatSolve(solve)}</strong>`;
        solveList.appendChild(li);
      });

      const validTimes = solves.map(getNumericTime).filter(t => t !== Infinity);
      bestTimeEl.textContent = validTimes.length > 0 ? Math.min(...validTimes).toFixed(2) + 's' : 'DNF';

      if (solves.length >= 5) {
        const last5 = solves.slice(-5).map(getNumericTime).sort((a, b) => a - b);
        const middle3 = last5.slice(1, 4);
        if (middle3.includes(Infinity)) {
          ao5TimeEl.textContent = 'DNF';
        } else {
          const avg = middle3.reduce((sum, val) => sum + val, 0) / 3;
          ao5TimeEl.textContent = avg.toFixed(2) + 's';
        }
      } else {
        ao5TimeEl.textContent = '-';
      }
    }

    function startTimer() {
      isRunning = true;
      startTime = performance.now();
      statusText.textContent = 'Timer running! Press SPACEBAR or Stop';
      timerInterval = setInterval(() => {
